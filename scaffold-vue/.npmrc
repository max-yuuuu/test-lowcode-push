cache=.npm-cache
fund=false
audit=false
# 物料包只发布在官方 registry，国内镜像同步新版本有延迟：滞后期间镜像上那份版本列表还没有这个号，
# caret 写法会直接 ETARGET 装不上。（registry 上那个 0.0.0-stage 是建 scope 时发的占位版本，
# 官方源也有它，不是镜像造的；caret 永不匹配 0.x，所以它不参与这件事。）
# 这个 scope 固定走源站，其余依赖仍跟随机器默认镜像，不牺牲安装速度。
@yuanda-lowcode-ai:registry=https://registry.npmjs.org
