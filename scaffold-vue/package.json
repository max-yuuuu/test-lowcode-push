{
  "name": "scaffold-vue",
  "version": "1.0.0",
  "private": true,
  "description": "通用后台管理脚手架前端宿主 app（Vue 3 + Vite + TS）：外壳、路由、登录与业务页面，物料依赖 @yuanda-lowcode-ai/scaffold-ui",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test:api": "node --test --experimental-strip-types src/api/__tests__/*.test.ts",
    "test:unit": "node --test --experimental-strip-types src/api/__tests__/*.test.ts src/shell/__tests__/*.test.ts src/data/__tests__/*.test.ts",
    "typecheck": "vue-tsc --noEmit",
    "bundle": "vite build",
    "build": "npm run typecheck && npm run bundle",
    "preview": "vite preview"
  },
  "dependencies": {
    "@yuanda-lowcode-ai/scaffold-ui": "^1.2.0",
    "gsap": "^3.15.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0"
  },
  "license": "MIT"
}
